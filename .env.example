# Venturo environment variables
# Copy to .env.local and fill in to enable cloud persistence + accounts.
# The app runs fully without these (browser localStorage) until then.

# Postgres connection (Supabase or any Postgres). Venturo creates its own
# isolated `venturo` schema, so it's safe to share a database with another app.
# Use the direct connection (port 5432) so migrations and DDL work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Signs the auth session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me"

# Then create the schema:  npm run db:migrate
